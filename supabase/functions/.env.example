# Secrets das Edge Functions — NUNCA no frontend nem no git.
# Produção:  supabase secrets set --env-file supabase/functions/.env
# Local:     supabase functions serve --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são injetadas pela plataforma.)

# App da Meta (developers.facebook.com › seu app › Configurações › Básico › Chave secreta do app)
META_APP_SECRET=
# Se o Instagram usa "API do Instagram com login do Instagram", o app do Instagram tem segredo próprio
INSTAGRAM_APP_SECRET=
# Texto livre escolhido por você; o mesmo valor vai no campo "Verificar token" do webhook na Meta
META_VERIFY_TOKEN=

# Tokens de acesso (fallback). Preferível: token por canal no Vault via RPC admin_set_channel_token.
# WhatsApp: token de Usuário do Sistema (Business Manager) com whatsapp_business_messaging e whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
# Instagram: token de longa duração da conta profissional (instagram_business_basic + instagram_business_manage_messages)
INSTAGRAM_ACCESS_TOKEN=

# Segredo do worker chamado pelo pg_cron (gere com: openssl rand -hex 32). Mesmo valor no Vault (worker_secret).
WORKER_SECRET=

# Origens do frontend autorizadas a chamar as funções (CORS), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3100,https://crm.tchexperiencia.com.br
# URL pública do CRM (link do convite por e-mail)
SITE_URL=https://crm.tchexperiencia.com.br

# Opcionais
CAMPAIGN_BATCH=200
LOG_LEVEL=info
