{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/colecoes/saunas/",
      "destination": "/#catalogo",
      "permanent": true
    },
    {
      "source": "/colecoes/:c(banheiras|spas)/",
      "destination": "/#banheiras",
      "permanent": true
    },
    {
      "source": "/colecoes/:p(.*)",
      "destination": "/#categorias",
      "permanent": true
    },
    {
      "source": "/produto/:s(sauna-.*)",
      "destination": "/#catalogo",
      "permanent": true
    },
    {
      "source": "/produto/:s(banheira-.*|spa-.*)",
      "destination": "/#banheiras",
      "permanent": true
    },
    {
      "source": "/produto/:p(.*)",
      "destination": "/#categorias",
      "permanent": true
    },
    {
      "source": "/:p(contato|showroom|sobre)/",
      "destination": "/#loja",
      "permanent": true
    },
    {
      "source": "/:p(ambientes|selecao|busca)/:rest(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}